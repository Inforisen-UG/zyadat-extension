{
  "manifest_version": 3,
  "name": "Duplicate Provider Selector",
  "version": "1.0.0",
  "description": "Select duplicate provider service IDs in service tables (keeps one per provider ID).",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Select Duplicate Providers"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
